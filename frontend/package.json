{
  "name": "bikemapy-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "scan:bundle": "python3 ../scripts/check_frontend_bundle.py dist",
    "build:preview": "VITE_ENABLE_REPORTS=false pnpm build && pnpm scan:bundle --read-only",
    "build:pages": "if [ \"$CF_PAGES_BRANCH\" = \"main\" ]; then pnpm build && pnpm scan:bundle; else VITE_ENABLE_REPORTS=false pnpm build && pnpm scan:bundle --read-only; fi",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:generate": "openapi-typescript ../openapi.yaml -o src/api/generated/schema.ts && prettier --write src/api/generated/schema.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.10.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.5.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.3.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "source-map-js": "^1.2.2",
      "undici@8": "^8.12.2",
      "zod@4": "^4.6.6"
    }
  }
}
