# Public, non-secret frontend configuration.
# Local development default; deployable builds require a public HTTPS origin.
VITE_API_URL=http://localhost:8000
VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_TURNSTILE_SITE_KEY=
# Public Cloudflare Web Analytics token; leave empty to disable the beacon.
VITE_CF_WEB_ANALYTICS_TOKEN=
# Cloudflare PR previews must set this to false; production can enable reports.
VITE_ENABLE_REPORTS=true
# Category filtering and labels are intentionally off until catalogue support is ready.
VITE_ENABLE_CATEGORIES=false
# Replace the style URL to use a self-hosted or hosted MapLibre style. Leave
# VITE_MAP_ATTRIBUTION unset so the required linked OpenFreeMap/OpenMapTiles/
# OpenStreetMap attribution is used. Any override must preserve equivalent
# links and wording.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
