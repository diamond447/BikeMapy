# Copy to .env for local Compose development. Values here are local-only defaults.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-development-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=bikemapy
POSTGRES_USER=bikemapy
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_DATABASE_ENGINE=django.contrib.gis.db.backends.postgis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
