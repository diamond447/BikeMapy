# Copy to .env for local Compose development. Values here are local-only defaults.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-development-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=bikemapy
POSTGRES_USER=bikemapy
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_DATABASE_ENGINE=django.contrib.gis.db.backends.postgis
DJANGO_MEDIA_ROOT=/app/storage/media
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
DJANGO_CACHE_URL=redis://redis:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated immutable numeric GitHub IDs permitted to use Django Admin.
# Keep empty until the owner has completed OAuth and verified the ID.
GITHUB_OWNER_IDS=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# The private game stays disabled unless explicitly enabled. These Strava
# scopes exclude Only You activities. Keep all values out of version control.
GAME_ENABLED=false
STRAVA_OAUTH_CLIENT_ID=
STRAVA_OAUTH_CLIENT_SECRET=
STRAVA_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/game/auth/strava/callback/
GAME_FRONTEND_URL=http://localhost:5173/game
# Stable domain-separated HMAC key for Strava athlete lifecycle guards. Keep
# this secret stable across deployments; it is required when GAME_ENABLED=true.
STRAVA_IDENTITY_GUARD_KEY=
# Generate a Fernet key with `uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'`.
STRAVA_TOKEN_ENCRYPTION_KEY=
# Verify-token for Strava's subscription challenge. Keep this separate from
# the OAuth client secret and rotate it if a webhook endpoint is exposed.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Numeric Strava webhook subscription ID returned when the subscription is
# created; events from any other subscription are rejected.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
# Bounded activity synchronization; lower page/budget values protect the
# Strava quota while the durable cursor makes the import resumable.
STRAVA_API_TIMEOUT=10
STRAVA_SYNC_PAGE_SIZE=100
STRAVA_SYNC_PAGES_PER_RUN=5
STRAVA_SYNC_LEASE_SECONDS=600
STRAVA_SYNC_DISPATCH_LEASE_SECONDS=60
# Bound provider Retry-After and quota-reset delays to one hour.
STRAVA_SYNC_MAX_RETRY_AFTER=3600
# Cloudflare Turnstile server secret for anonymous reports.
REPORT_TURNSTILE_SECRET_KEY=
REPORT_RATE_LIMIT_HMAC_SECRET=
RATE_LIMIT_HMAC_SECRET=
REPORT_RATE_LIMIT_HOURLY=3
REPORT_RATE_LIMIT_DAILY=10
# Local Compose uses direct REMOTE_ADDR; production trusts only its Nginx peer.
REPORT_CLIENT_IP_MODE=direct
REPORT_TRUSTED_PROXY_CIDRS=
REPORT_DUPLICATE_WINDOW=86400
REPORT_EMAIL_RETENTION=7776000
REPORT_DETAILS_RETENTION=31536000
# Identify the crawler and keep its default request rate deliberately low.
BIKEFORUM_USER_AGENT=BikeMapyBot/1.0 (+https://github.com/diamond447/BikeMapy)
BIKEFORUM_TIMEOUT=15
BIKEFORUM_RATE_LIMIT=2
BIKEFORUM_RETRIES=2
BIKEFORUM_BACKOFF=1
BIKEFORUM_CACHE_TTL=3600
# Raw response bodies expire for replay after 24 hours. An hourly bounded
# cleanup clears eligible rows from the live DB; validators remain available.
BIKEFORUM_CACHE_BODY_RETENTION_SECONDS=86400
BIKEFORUM_CACHE_CLEANUP_BATCH_SIZE=500
# Keep real-source crawling disabled until provider/operator approval is recorded.
BIKEFORUM_CRAWL_ENABLED=false
BIKEFORUM_PROVIDER_AUTHORIZED=false
BIKEFORUM_OPERATOR_APPROVED=false
BIKEFORUM_MAX_PAGES=100
BIKEFORUM_ALLOWED_ORIGINS=https://www.bike-forum.cz
BIKEFORUM_DNS_CHECK=true
BIKEFORUM_LEASE_SECONDS=600
BIKEFORUM_PAGE_ATTEMPTS=3
BIKEFORUM_INCREMENTAL_URL=https://www.bike-forum.cz/forum/
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_PUBLIC_SITE_URL=http://localhost:5173
# Public Cloudflare Web Analytics token; the beacon is not loaded when empty.
VITE_CF_WEB_ANALYTICS_TOKEN=
# Keep public GPX redistribution disabled until terms and rights review passes.
GPX_REDISTRIBUTION_APPROVED=false
GPX_EXTRACTION_ENABLED=false
GPX_PROVIDER_AUTHORIZED=false
GPX_LEGAL_APPROVED=false
GPX_MAX_ATTEMPTS=3
GPX_DISPATCH_TIMEOUT=900
GPX_PROCESSING_TIMEOUT=1800
GPX_ORPHAN_CLEANUP_MAX_ATTEMPTS=5
GPX_ORPHAN_CLEANUP_RETRY_BASE_SECONDS=60
GPX_ORPHAN_CLEANUP_RETRY_MAX_SECONDS=3600
GPX_ORPHAN_CLEANUP_LEASE_SECONDS=900
GPX_INTERNAL_REDIRECT=false
# Optional Sentry error monitoring. Configure the Sentry project retention to
# 30 days; the SDK never sends default PII and scrubs request identifiers.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RETENTION_DAYS=30
CRAWLER_FRESHNESS_MAX_AGE=129600
