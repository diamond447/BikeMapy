# Copy to .env for local Compose development. Values here are local-only defaults.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-development-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=bikemapy
POSTGRES_USER=bikemapy
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_DATABASE_ENGINE=django.contrib.gis.db.backends.postgis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
DJANGO_CACHE_URL=redis://redis:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Identify the crawler and keep its default request rate deliberately low.
BIKEFORUM_USER_AGENT=BikeMapyBot/1.0 (+https://github.com/diamond447/BikeMapy)
BIKEFORUM_TIMEOUT=15
BIKEFORUM_RATE_LIMIT=2
BIKEFORUM_RETRIES=2
BIKEFORUM_BACKOFF=1
BIKEFORUM_CACHE_TTL=3600
BIKEFORUM_MAX_PAGES=100
BIKEFORUM_ALLOWED_ORIGINS=https://www.bike-forum.cz
BIKEFORUM_DNS_CHECK=true
BIKEFORUM_LEASE_SECONDS=600
BIKEFORUM_PAGE_ATTEMPTS=3
BIKEFORUM_INCREMENTAL_URL=https://www.bike-forum.cz/forum/
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
