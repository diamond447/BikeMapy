# Copy to .env for local Compose development. Values here are local-only defaults.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-development-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=bikemapy
POSTGRES_USER=bikemapy
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_DATABASE_ENGINE=django.contrib.gis.db.backends.postgis
DJANGO_MEDIA_ROOT=/app/storage/media
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
DJANGO_CACHE_URL=redis://redis:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated immutable numeric GitHub IDs permitted to use Django Admin.
# Keep empty until the owner has completed OAuth and verified the ID.
GITHUB_OWNER_IDS=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Cloudflare Turnstile server secret for anonymous reports.
REPORT_TURNSTILE_SECRET_KEY=
REPORT_RATE_LIMIT_HMAC_SECRET=
REPORT_RATE_LIMIT_HOURLY=3
REPORT_RATE_LIMIT_DAILY=10
# Local Compose uses direct REMOTE_ADDR; production trusts only its Nginx peer.
REPORT_CLIENT_IP_MODE=direct
REPORT_TRUSTED_PROXY_CIDRS=
REPORT_DUPLICATE_WINDOW=86400
REPORT_EMAIL_RETENTION=7776000
REPORT_DETAILS_RETENTION=31536000
# Identify the crawler and keep its default request rate deliberately low.
BIKEFORUM_USER_AGENT=BikeMapyBot/1.0 (+https://github.com/diamond447/BikeMapy)
BIKEFORUM_TIMEOUT=15
BIKEFORUM_RATE_LIMIT=2
BIKEFORUM_RETRIES=2
BIKEFORUM_BACKOFF=1
BIKEFORUM_CACHE_TTL=3600
BIKEFORUM_MAX_PAGES=100
BIKEFORUM_ALLOWED_ORIGINS=https://www.bike-forum.cz
BIKEFORUM_DNS_CHECK=true
BIKEFORUM_LEASE_SECONDS=600
BIKEFORUM_PAGE_ATTEMPTS=3
BIKEFORUM_INCREMENTAL_URL=https://www.bike-forum.cz/forum/
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_PUBLIC_SITE_URL=http://localhost:5173
# Keep public GPX redistribution disabled until terms and rights review passes.
GPX_REDISTRIBUTION_APPROVED=false
GPX_INTERNAL_REDIRECT=false
# Optional Sentry error monitoring. Configure the Sentry project retention to
# 30 days; the SDK never sends default PII and scrubs request identifiers.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RETENTION_DAYS=30
CRAWLER_FRESHNESS_MAX_AGE=129600
