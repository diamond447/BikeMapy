# Copy to .env.production on the host. This file is never copied into the
# backend image. Use a digest or sha-* tag selected from the image provenance.
BIKEMAPY_BACKEND_IMAGE=ghcr.io/diamond447/bikemapy-backend@sha256:replace-me
PUBLIC_HOST=api.example.invalid
ACME_EMAIL=ops@example.invalid
POSTGRES_DB=bikemapy
POSTGRES_USER=bikemapy
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# `backend` is the internal Compose service name used by the readiness check.
DJANGO_ALLOWED_HOSTS=api.example.invalid,backend
DJANGO_MEDIA_ROOT=/app/storage/media
DJANGO_DATABASE_ENGINE=django.contrib.gis.db.backends.postgis
DJANGO_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=https://bikemapy.pages.dev,https://www.example.invalid
READ_ONLY_PREVIEW_ORIGIN_REGEX=\Ahttps://([a-z0-9-]+\.)+bikemapy\.pages\.dev\Z
USE_X_FORWARDED_HOST=true
GITHUB_OWNER_IDS=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
REPORT_TURNSTILE_SECRET_KEY=
REPORT_RATE_LIMIT_HMAC_SECRET=
REPORT_CLIENT_IP_MODE=cloudflare
REPORT_TRUSTED_PROXY_CIDRS=172.30.0.2/32
GPX_REDISTRIBUTION_APPROVED=false
GPX_EXTRACTION_ENABLED=false
GPX_PROVIDER_AUTHORIZED=false
GPX_LEGAL_APPROVED=false
GPX_MAX_ATTEMPTS=3
GPX_DISPATCH_TIMEOUT=900
GPX_PROCESSING_TIMEOUT=1800
GPX_INTERNAL_REDIRECT=true
