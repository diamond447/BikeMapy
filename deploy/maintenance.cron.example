# Lean mode only (compose.lean.yml): there is no Celery beat, so run the
# scheduled maintenance tasks (report retention, crawler cache expiry, GPX
# reconciliation and deletion retries) from the host every hour.
15 * * * * cd /srv/bikemapy && docker compose --env-file deploy/.env.production -f deploy/compose.production.yml -f deploy/compose.lean.yml exec -T backend uv run --locked --no-dev python backend/manage.py run_periodic_tasks >> /var/log/bikemapy-maintenance.log 2>&1
# Once crawling is approved (BIKEFORUM_CRAWL_ENABLED=true), add the daily crawl.
# 30 3 * * * cd /srv/bikemapy && docker compose --env-file deploy/.env.production -f deploy/compose.production.yml -f deploy/compose.lean.yml exec -T backend uv run --locked --no-dev python backend/manage.py run_periodic_tasks --with-crawl >> /var/log/bikemapy-maintenance.log 2>&1
